+    # Validate metadata without allocating CUDA tensors on CPU test hosts.
+    monkeypatch.setattr(fused, "HAS_TRITON", True)
+    monkeypatch.setattr(fused, "current_platform", SimpleNamespace(is_cuda=lambda: True))
