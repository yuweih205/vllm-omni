+def test_strict_numerics_rejects_batch_invariant_reference(monkeypatch):
+    import vllm
+
+    from vllm_omni.diffusion.layers import fused_qk_norm_rope as fused
+
+    monkeypatch.setattr(fused, "HAS_TRITON", True)
+    monkeypatch.setattr(fused, "current_platform", SimpleNamespace(is_cuda=lambda: True))
