+    weight = SimpleNamespace(device=torch.device(weight_device), dtype=weight_dtype)
+    with pytest.raises(ValueError, match=message):
+        fused._validate_reduction_parameters(
+            (activation,), (weight,), head_dim, rotary_dim, True, "vllm_cuda_128", False
+        )
