diff --git a/tests/diffusion/layers/test_fused_qk_norm_rope.py b/tests/diffusion/layers/test_fused_qk_norm_rope.py
index 19a71f8d..8b362933 100644
--- a/tests/diffusion/layers/test_fused_qk_norm_rope.py
+++ b/tests/diffusion/layers/test_fused_qk_norm_rope.py
@@ -82,6 +82,92 @@ def test_fused_qk_norm_rope_matches_bf16_reference(seq_len):
     torch.testing.assert_close(actual_k, expected_k, atol=0.0625, rtol=0.02)
 
 
+def _cuda_rms_norm_interleaved_reference(q, k, q_weight, k_weight, rope_table, eps):
+    """The vllm_c CUDA RMSNorm op followed by eager FP32 RoPE and BF16 output."""
+    from vllm import _custom_ops as ops
+
+    def apply(x, weight):
+        normalized = torch.empty(x.shape, device=x.device, dtype=x.dtype)
+        # Call the CUDA provider directly so IR priorities and batch-invariant
+        # settings cannot silently change the arithmetic being compared.
+        ops.rms_norm(normalized, x.contiguous(), weight, eps)
+        normalized = normalized.float()
+        cos = rope_table[:, :64].float().unsqueeze(1)
+        sin = rope_table[:, 64:].float().unsqueeze(1)
+        even, odd = normalized[..., ::2], normalized[..., 1::2]
+        return torch.stack((even * cos - odd * sin, odd * cos + even * sin), dim=-1).flatten(-2).to(x.dtype)
+
+    return apply(q, q_weight), apply(k, k_weight)
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="CUDA required")
+@pytest.mark.skipif(not HAS_TRITON, reason="Triton required")
+@pytest.mark.parametrize("table_dtype", [torch.bfloat16, torch.float32])
+@pytest.mark.parametrize("eps", [1e-6, 1e-5])
+def test_fused_qk_norm_rope_vllm_cuda_128_eager_bitwise(table_dtype, eps):
+    from vllm_omni.diffusion.layers.fused_qk_norm_rope import fused_qk_norm_rope
+
+    torch.manual_seed(20261008)
+    # Q/K are projection slices, including unequal head counts and tail tiles.
+    qkv = torch.randn((257, 13, 128), device="cuda", dtype=torch.bfloat16)
+    q, k = qkv[:, :7], qkv[:, 7:10]
+    q_weight = torch.empty(128, device="cuda", dtype=torch.bfloat16).uniform_(0.5, 1.5)
+    k_weight = torch.empty_like(q_weight).uniform_(0.5, 1.5)
+    theta = torch.randn((257, 64), device="cuda", dtype=torch.float32)
+    table = torch.cat((theta.cos(), theta.sin()), dim=-1).to(table_dtype)
+    with torch.inference_mode():
+        expected = _cuda_rms_norm_interleaved_reference(q, k, q_weight, k_weight, table, eps)
+        actual = fused_qk_norm_rope(
+            q,
+            k,
+            q_weight,
+            k_weight,
+            table,
+            eps,
+            interleaved=True,
+            rms_norm_reduction="vllm_cuda_128",
+            enable_fp_fusion=False,
+        )
+    for output, reference in zip(actual, expected):
+        # Compare storage bits so signed-zero differences are also detected.
+        assert torch.equal(output.contiguous().view(torch.int16), reference.contiguous().view(torch.int16))
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="CUDA required")
+@pytest.mark.skipif(not HAS_TRITON, reason="Triton required")
+def test_fused_joint_qkv_norm_rope_vllm_cuda_128_eager_bitwise(monkeypatch):
+    from vllm_omni.diffusion.layers.fused_qk_norm_rope import fused_joint_qkv_norm_rope
+
+    monkeypatch.setenv("VLLM_OMNI_FUSED_QK_NORM_ROPE_NUMERICS", "vllm_cuda_128")
+    torch.manual_seed(20261008)
+    batch, length0, length1 = 2, 5, 3
+    qkv0 = torch.randn((batch, length0, 13, 128), device="cuda", dtype=torch.bfloat16)
+    qkv1 = torch.randn((batch, length1, 13, 128), device="cuda", dtype=torch.bfloat16)
+    q0, k0, v0 = qkv0[:, :, :7], qkv0[:, :, 7:10], qkv0[:, :, 10:]
+    q1, k1, v1 = qkv1[:, :, :7], qkv1[:, :, 7:10], qkv1[:, :, 10:]
+    weights = [torch.empty(128, device="cuda", dtype=torch.bfloat16).uniform_(0.5, 1.5) for _ in range(4)]
+    theta = torch.randn((batch, length0 + length1, 64), device="cuda", dtype=torch.float32)
+    table = torch.cat((theta.cos(), theta.sin()), dim=-1)
+    with torch.inference_mode():
+        streams = []
+        for q, k, qw, kw, local_table in (
+            (q0, k0, weights[0], weights[1], table[:, :length0]),
+            (q1, k1, weights[2], weights[3], table[:, length0:]),
+        ):
+            q_ref, k_ref = _cuda_rms_norm_interleaved_reference(
+                q.reshape(-1, 7, 128), k.reshape(-1, 3, 128), qw, kw, local_table.reshape(-1, 128), 1e-6
+            )
+            streams.append((q_ref.view(batch, -1, 7, 128), k_ref.view(batch, -1, 3, 128)))
+        expected = (
+            torch.cat((streams[0][0], streams[1][0]), dim=1),
+            torch.cat((streams[0][1], streams[1][1]), dim=1),
+            torch.cat((v0, v1), dim=1),
+        )
+        actual = fused_joint_qkv_norm_rope(q0, k0, v0, q1, k1, v1, *weights, table.reshape(-1, 128), 1e-6)
+    for output, reference in zip(actual, expected):
+        assert torch.equal(output.contiguous().view(torch.int16), reference.contiguous().view(torch.int16))
+
+
