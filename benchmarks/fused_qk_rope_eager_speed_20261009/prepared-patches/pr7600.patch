+@pytest.mark.parametrize("value", [None, "", "  ", "fast", " fast "])
+def test_numerical_preset_keeps_default_parameters(monkeypatch, value):
+    from vllm_omni.diffusion.layers.fused_qk_norm_rope import _resolve_numerical_parameters
+
+    if value is None:
+        monkeypatch.delenv(_NUMERICS, raising=False)
+    else:
+        monkeypatch.setenv(_NUMERICS, value)
+    assert _resolve_numerical_parameters(None, None) == ("triton", True)
+
+
+def test_numerical_preset_resolves_at_each_call_and_kwargs_override(monkeypatch):
+    from vllm_omni.diffusion.layers.fused_qk_norm_rope import _resolve_numerical_parameters
+
+    monkeypatch.setenv(_NUMERICS, "vllm_cuda_128")
+    assert _resolve_numerical_parameters(None, None) == ("vllm_cuda_128", False)
+    assert _resolve_numerical_parameters("triton", None) == ("triton", True)
+    assert _resolve_numerical_parameters("triton", False) == ("triton", False)
+    monkeypatch.setenv(_NUMERICS, "fast")
+    assert _resolve_numerical_parameters(None, None) == ("triton", True)
+    assert _resolve_numerical_parameters("vllm_cuda_128", None) == ("vllm_cuda_128", False)
+
+
+@pytest.mark.parametrize("value", ["bitwise", "triton", "unknown"])
+def test_invalid_numerical_preset_names_the_variable(monkeypatch, value):
+    from vllm_omni.diffusion.layers.fused_qk_norm_rope import _resolve_numerical_parameters
+
+    monkeypatch.setenv(_NUMERICS, value)
+    with pytest.raises(ValueError, match=_NUMERICS):
+        _resolve_numerical_parameters(None, None)
+    assert _resolve_numerical_parameters("triton", True) == ("triton", True)
+
+
+@pytest.mark.parametrize("operator", ["single", "joint"])
+def test_strict_numerics_rejects_cpu_instead_of_silent_fallback(monkeypatch, operator):
+    from vllm_omni.diffusion.layers.fused_qk_norm_rope import fused_joint_qkv_norm_rope, fused_qk_norm_rope
+
+    monkeypatch.setenv(_NUMERICS, "vllm_cuda_128")
+    q = torch.ones((2, 3, 128), dtype=torch.bfloat16)
+    weight = torch.ones(128, dtype=torch.bfloat16)
+    if operator == "single":
+        table = torch.ones((2, 128), dtype=torch.float32)
+
+        def call():
+            return fused_qk_norm_rope(q, q, weight, weight, table, 1e-6, interleaved=True)
+
+    else:
+        q = q.unsqueeze(0)
+        table = torch.ones((4, 128), dtype=torch.float32)
+
+        def call():
+            return fused_joint_qkv_norm_rope(q, q, q, q, q, q, weight, weight, weight, weight, table, 1e-6)
+
+    with pytest.raises(ValueError, match="CUDA"):
+        call()
+
+
